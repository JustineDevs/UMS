{
  "name": "e-commerce-website",
  "private": true,
  "scripts": {
    "deps:clean-drift": "node stress-test/scripts/clean-native-package-drift.cjs",
    "dev": "pnpm cleanup:dev && node scripts/dev-worker-first.mjs",
    "diagnose:dev-memory": "node scripts/dev-memory-probe.mjs -- pnpm dev",
    "kill-ports": "node stress-test/scripts/kill-project-ports.js",
    "cleanup:dev": "node scripts/cleanup-dev-runtime.cjs",
    "commit:sh": "bash scripts/commit/parallel-commit.sh",
    "security:check": "node scripts/commit/cli/index.js security",
    "verify:matrix-evidence": "node scripts/verify-matrix-evidence.cjs",
    "write:matrix-evidence": "node scripts/write-matrix-evidence.cjs",
    "bruno:generate": "node scripts/generate-bruno-collection.mjs",
    "generate:admin-openapi": "pnpm exec tsx scripts/generate-admin-openapi-docs.mjs",
    "build": "node scripts/run-bounded-build.cjs",
    "lint": "pnpm exec turbo lint --filter=@universal-music-store/web... --concurrency=2",
    "typecheck": "pnpm --filter web typecheck && pnpm exec tsc --noEmit --pretty false -p workers/backend/tsconfig.json && pnpm --filter @universal-music-store/sdk typecheck && pnpm --filter @universal-music-store/resend-mail typecheck",
    "ci:preflight": "node scripts/ci-preflight.cjs",
    "backend:worker:dev": "pnpm exec wrangler dev --show-interactive-dev-session=false",
    "typecheck:backend:worker": "pnpm exec tsc --noEmit --pretty false -p workers/backend/tsconfig.json",
    "backend:worker:config-preflight": "node scripts/cloudflare-worker-config-preflight.mjs",
    "backend:worker:deploy": "pnpm backend:worker:config-preflight && pnpm exec wrangler deploy --env dev",
    "backend:worker:deploy:production": "pnpm backend:worker:config-preflight && pnpm exec wrangler deploy --env production",
    "test:backend:worker": "pnpm exec tsx --test workers/backend/src/index.test.ts",
    "test:backend:worker:all": "pnpm exec tsx --test workers/backend/src/*.test.ts",
    "db:migrate": "pnpm --filter @universal-music-store/database migrate",
    "db:migrate:status": "pnpm --filter @universal-music-store/database migrate:status",
    "db:migrate:worker": "node scripts/run-worker-migrations.mjs",
    "db:migrate:worker:medusa": "node scripts/run-worker-migrations.mjs --target=medusa",
    "db:check:worker": "node scripts/run-worker-migrations.mjs --status",
    "db:seed": "pnpm --filter @universal-music-store/database seed",
    "test": "node stress-test/scripts/check-test-runtime.cjs esbuild && pnpm --filter @universal-music-store/platform-data build && pnpm --filter @universal-music-store/platform-data test && pnpm --filter @universal-music-store/ui build && pnpm --filter @universal-music-store/sdk build && pnpm --filter @universal-music-store/sdk test && pnpm --filter @universal-music-store/validation test && pnpm --filter @universal-music-store/omnichannel-policy test && pnpm --filter @universal-music-store/rate-limits test && pnpm --filter @universal-music-store/database test && pnpm --filter @universal-music-store/web exec node scripts/run-all-tests.cjs",
    "check:migration-boundary": "node stress-test/scripts/check-commerce-migration-boundary.mjs",
    "check:storefront-client": "node stress-test/scripts/check-storefront-client-boundary.mjs",
    "check:admin-api-guard": "node stress-test/scripts/check-admin-api-staff-guard.mjs",
    "check:admin-openapi": "node stress-test/scripts/check-admin-openapi.mjs",
    "check:admin-openapi-source": "node scripts/check-admin-openapi-source-drift.mjs",
    "check:webhook-proxy-boundary": "node scripts/check-webhook-proxy-boundary.mjs",
    "generate:route-ownership": "node scripts/generate-route-ownership-manifest.mjs",
    "check:route-ownership": "node scripts/check-route-ownership.mjs",
    "generate:route-state": "node scripts/generate-route-state-manifest.mjs",
    "check:route-state": "node scripts/check-route-state-manifest.mjs",
    "quality:knip": "pnpm dlx knip@6.32.1 --no-progress --reporter compact --no-exit-code",
    "quality:react-doctor": "node scripts/check-react-doctor.cjs",
    "check:audit-triage": "node stress-test/scripts/check-audit-triage.js",
    "quality:contracts": "pnpm run check:admin-api-guard && pnpm run check:admin-openapi && pnpm run check:admin-openapi-source && pnpm run check:webhook-proxy-boundary && pnpm run check:route-ownership && pnpm run check:route-state && pnpm run check:storefront-client && pnpm run check:migration-boundary && pnpm run check:audit-triage",
    "stress-test": "node stress-test/scripts/check-test-runtime.cjs esbuild && node stress-test/scripts/stress-test.js",
    "release-gate": "node stress-test/scripts/check-test-runtime.cjs esbuild && node stress-test/scripts/release-gate.js",
    "e2e:ensure-staff": "pnpm --filter @universal-music-store/database e2e:ensure-staff",
    "e2e:prep": "pnpm e2e:ensure-staff",
    "test:e2e:performance": "node stress-test/scripts/run-e2e.js stress-test/e2e/smoke/storefront-performance.spec.ts --project=chromium --workers=1",
    "test:restore-drill": "node scripts/restore-drill.cjs",
    "test:http-flow": "node stress-test/scripts/run-http-flow.cjs",
    "test:http-flow:with-webservers": "node stress-test/scripts/run-e2e.js stress-test/e2e/flows/http-flow-matrix.spec.ts",
    "test:e2e": "node stress-test/scripts/run-e2e.js",
    "test:e2e:smoke": "node stress-test/scripts/run-e2e.js --grep @smoke",
    "test:e2e:workflow": "node stress-test/scripts/run-e2e.js --grep @workflow",
    "test:e2e:checkout": "node stress-test/scripts/run-e2e.js stress-test/e2e/workflows/checkout-harness.spec.ts stress-test/e2e/flows/full-commerce-journey.spec.ts",
    "test:e2e:admin": "node stress-test/scripts/run-e2e.js --grep @admin",
    "test:e2e:matrix": "node stress-test/scripts/run-e2e.js stress-test/e2e/components stress-test/e2e/layouts",
    "test:e2e:chaos": "node stress-test/scripts/run-e2e.js stress-test/e2e/workflows/chaos-network.spec.ts",
    "test:e2e:cross-app": "node stress-test/scripts/run-e2e.js stress-test/e2e/workflows/cross-app-sync.spec.ts",
  "test:e2e:critical": "node stress-test/scripts/run-critical-e2e.cjs",
  "test:e2e:api-health": "node stress-test/scripts/run-e2e.js stress-test/e2e/smoke/storefront-api-health.spec.ts stress-test/e2e/smoke/admin-api-health.spec.ts",
    "test:e2e:psp-full": "node stress-test/scripts/run-e2e.js stress-test/e2e/flows/psp-checkout-stripe.spec.ts stress-test/e2e/flows/psp-checkout-paypal.spec.ts stress-test/e2e/flows/psp-checkout-xendit.spec.ts stress-test/e2e/flows/psp-checkout-cod.spec.ts --workers=1",
    "test:e2e:stress": "node stress-test/scripts/run-e2e.js stress-test/e2e/flows/end-to-end-stress-journey.spec.ts",
    "test:e2e:ui": "node stress-test/scripts/run-e2e.js --ui",
    "dogfood:screenshots": "node stress-test/scripts/run-e2e.js dogfood --project=chromium",
    "predeploy": "pnpm install --frozen-lockfile && pnpm run build",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
