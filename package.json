{
  "name": "e-commerce-website",
  "private": true,
  "scripts": {
    "deps:clean-drift": "node stress-test/scripts/clean-native-package-drift.cjs",
    "dev": "pnpm cleanup:dev && node stress-test/scripts/dev-with-medusa-first.mjs",
    "dev:parallel": "pnpm kill-ports && node stress-test/scripts/dev-parallel-no-health-ordering.mjs",
    "kill-ports": "node stress-test/scripts/kill-project-ports.js",
    "cleanup:dev": "node scripts/cleanup-dev-runtime.cjs",
    "commit:sh": "bash scripts/commit/parallel-commit.sh",
    "security:check": "node scripts/commit/cli/index.js security",
    "verify:matrix-evidence": "node scripts/verify-matrix-evidence.cjs",
    "write:matrix-evidence": "node scripts/write-matrix-evidence.cjs",
    "bruno:generate": "node scripts/generate-bruno-collection.mjs",
    "build": "pnpm exec turbo build",
    "lint": "pnpm exec turbo lint",
    "ci:preflight": "node scripts/ci-preflight.cjs",
    "ci:preflight:full": "node scripts/ci-preflight-full.cjs",
    "db:migrate": "pnpm --filter @universal-music-store/database migrate",
    "db:migrate:status": "pnpm --filter @universal-music-store/database migrate:status",
    "medusa:seed:categories": "pnpm --filter medusa seed:categories",
    "db:seed": "pnpm --filter @universal-music-store/database seed",
    "test": "node stress-test/scripts/check-test-runtime.cjs esbuild && pnpm --filter @universal-music-store/platform-data test && pnpm --filter @universal-music-store/ui build && pnpm --filter @universal-music-store/sdk test && pnpm --filter @universal-music-store/validation test && pnpm --filter @universal-music-store/omnichannel-policy test && pnpm --filter @universal-music-store/rate-limits test && pnpm --filter @universal-music-store/api test && pnpm --filter @universal-music-store/database test && pnpm --filter @universal-music-store/admin test && pnpm --filter @universal-music-store/storefront test && pnpm --filter medusa test:unit && pnpm --filter medusa test:stress",
    "check:migration-boundary": "node stress-test/scripts/check-commerce-migration-boundary.mjs",
    "audit:medusa-schema:copy": "node stress-test/scripts/copy-medusa-schema-artifact.mjs",
    "check:storefront-client": "node stress-test/scripts/check-storefront-client-boundary.mjs",
    "check:admin-api-guard": "node stress-test/scripts/check-admin-api-staff-guard.mjs",
    "check:admin-openapi": "node stress-test/scripts/check-admin-openapi.mjs",
    "quality:knip": "pnpm dlx knip@6.32.1 --no-progress --reporter compact --no-exit-code",
    "quality:react-doctor": "node scripts/check-react-doctor.cjs",
    "check:audit-triage": "node stress-test/scripts/check-audit-triage.js",
    "quality:contracts": "pnpm run check:admin-api-guard && pnpm run check:admin-openapi && pnpm run check:storefront-client && pnpm run check:migration-boundary && pnpm run check:audit-triage",
    "stress-test": "node stress-test/scripts/check-test-runtime.cjs esbuild && node stress-test/scripts/stress-test.js",
    "stress-test:quick": "node stress-test/scripts/check-test-runtime.cjs esbuild && node stress-test/scripts/stress-test.js --no-e2e --no-dogfood",
    "release-gate": "node stress-test/scripts/check-test-runtime.cjs esbuild && node stress-test/scripts/release-gate.js",
    "release-gate:full": "node stress-test/scripts/check-test-runtime.cjs esbuild && node stress-test/scripts/release-gate.js --include-e2e",
    "e2e:prep:medusa": "node stress-test/scripts/e2e-prep-medusa.mjs",
    "e2e:prep:medusa:force": "node stress-test/scripts/e2e-prep-medusa.mjs --force",
    "e2e:ensure-staff": "pnpm --filter @universal-music-store/database e2e:ensure-staff",
    "e2e:prep": "node stress-test/scripts/e2e-prep-medusa.mjs && pnpm e2e:ensure-staff",
    "test:psp-sandbox": "node stress-test/scripts/test-psp-sandbox.cjs",
    "test:load": "node stress-test/scripts/run-http-load.cjs",
    "test:e2e:performance": "node stress-test/scripts/run-e2e.js stress-test/e2e/smoke/storefront-performance.spec.ts --project=chromium --workers=1",
    "test:restore-drill": "node scripts/restore-drill.cjs",
    "test:http-flow": "node stress-test/scripts/run-http-flow.cjs",
    "test:http-flow:with-webservers": "node stress-test/scripts/run-e2e.js stress-test/e2e/flows/http-flow-matrix.spec.ts",
    "stress-test:checkout-providers": "pnpm exec tsx stress-test/scripts/stress-checkout-providers.ts",
    "preflight:checkout-payment-matrix": "pnpm exec tsx stress-test/scripts/preflight-checkout-payment-matrix.ts",
    "test:e2e": "node stress-test/scripts/run-e2e.js",
    "test:e2e:smoke": "node stress-test/scripts/run-e2e.js --grep @smoke",
    "test:e2e:workflow": "node stress-test/scripts/run-e2e.js --grep @workflow",
    "test:e2e:checkout": "node stress-test/scripts/run-e2e.js stress-test/e2e/workflows/checkout-harness.spec.ts stress-test/e2e/flows/full-commerce-journey.spec.ts stress-test/e2e/flows/medusa-checkout-flow.spec.ts",
    "test:e2e:admin": "node stress-test/scripts/run-e2e.js --grep @admin",
    "test:e2e:matrix": "node stress-test/scripts/run-e2e.js stress-test/e2e/components stress-test/e2e/layouts",
    "test:e2e:chaos": "node stress-test/scripts/run-e2e.js stress-test/e2e/workflows/chaos-network.spec.ts",
    "test:e2e:cross-app": "node stress-test/scripts/run-e2e.js stress-test/e2e/workflows/cross-app-sync.spec.ts",
    "test:e2e:parallel": "node stress-test/scripts/run-e2e.js --workers=4",
    "test:e2e:critical": "node stress-test/scripts/run-e2e.js stress-test/e2e/smoke/service-health.spec.ts stress-test/e2e/flows/full-commerce-journey.spec.ts stress-test/e2e/flows/psp-checkout-cod.spec.ts stress-test/e2e/smoke/storefront-api-security.spec.ts stress-test/e2e/smoke/admin-access.spec.ts",
    "test:e2e:api-health": "node stress-test/scripts/run-e2e.js stress-test/e2e/smoke/service-health.spec.ts stress-test/e2e/smoke/storefront-api-health.spec.ts stress-test/e2e/smoke/admin-api-health.spec.ts",
    "test:e2e:psp-full": "node stress-test/scripts/run-e2e.js stress-test/e2e/flows/psp-checkout-stripe.spec.ts stress-test/e2e/flows/psp-checkout-paypal.spec.ts stress-test/e2e/flows/psp-checkout-xendit.spec.ts stress-test/e2e/flows/psp-checkout-cod.spec.ts --workers=1",
    "test:e2e:stress": "node stress-test/scripts/run-e2e.js stress-test/e2e/flows/end-to-end-stress-journey.spec.ts",
    "test:e2e:ui": "node stress-test/scripts/run-e2e.js --ui",
    "dogfood:screenshots": "node stress-test/scripts/run-e2e.js dogfood --project=chromium",
    "predeploy": "pnpm install --frozen-lockfile && pnpm run build",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
