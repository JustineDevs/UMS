{
  "extends": "@universal-music-store/config-typescript/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.mts",
    "src/**/*.spec.ts",
    "src/**/*.spec.mts",
    "src/**/*.stress.test.mts"
  ]
}
