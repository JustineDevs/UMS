{
  "extends": "@universal-music-store/config-typescript/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": false,
    "paths": {
      "@universal-music-store/platform-data": ["../platform-data/dist/index.d.ts"],
      "@universal-music-store/platform-data/*": ["../platform-data/dist/*.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.mts",
    "src/**/*.spec.ts",
    "src/**/*.spec.mts",
    "src/**/*.stress.test.mts"
  ]
}
