{
  "name": "@universal-music-store/sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cms-experiment-pick": {
      "types": "./dist/cms-experiment-pick.d.ts",
      "import": "./dist/cms-experiment-pick.js",
      "default": "./dist/cms-experiment-pick.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx/esm --test src/tracking-token.test.ts src/env/medusa-storefront.test.ts src/env/admin-medusa.test.ts src/cms-helpers.test.ts src/env/posthog.test.ts src/posthog.test.ts src/safe-url.test.ts src/analytics-contract.test.ts src/i18n.test.ts src/slo.test.ts src/slo-delivery.test.ts",
    "test:auth": "node --import tsx/esm --test src/auth-shared.test.ts"
  },
  "dependencies": {
    "@universal-music-store/platform-data": "workspace:*",
    "posthog-js": "^1.261.0"
  },
  "devDependencies": {
    "@universal-music-store/config-eslint": "workspace:*",
    "@universal-music-store/config-typescript": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
