{
  "name": "medusa",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "node ./scripts/run-build.cjs",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:ph": "medusa exec ./src/scripts/seed-ph.ts",
    "seed:categories": "medusa exec ./src/scripts/ensure-product-categories.ts",
    "exec:reconcile-payments": "medusa exec ./src/scripts/reconcile-pending-payments.ts",
    "import:legacy-catalog": "medusa exec ./src/scripts/import-legacy-catalog-jsonl.ts",
    "import:legacy-inventory": "medusa exec ./src/scripts/import-legacy-inventory-jsonl.ts",
    "start": "medusa start",
    "dev": "node ./scripts/run-dev.cjs",
    "test:integration:http": "node scripts/run-jest.cjs integration:http -- --silent=false --runInBand --forceExit",
    "test:integration:modules": "node scripts/run-jest.cjs integration:modules -- --silent=false --runInBand --forceExit",
    "test:unit": "node scripts/run-jest.cjs unit -- --silent --runInBand --forceExit",
    "test:stress": "node --import tsx/esm --test src/loaders/validate-process-env.stress.test.mts",
    "test:jnt-map": "tsx src/lib/jnt-status-map.test.mts"
  },
  "dependencies": {
    "@universal-music-store/sdk": "workspace:*",
    "@universal-music-store/types": "workspace:*",
    "@medusajs/admin-sdk": "2.17.2",
    "@medusajs/admin-shared": "2.17.2",
    "@medusajs/cli": "2.17.2",
    "@medusajs/dashboard": "2.17.2",
    "@medusajs/draft-order": "2.17.2",
    "@medusajs/event-bus-redis": "2.17.2",
    "@medusajs/framework": "2.17.2",
    "@medusajs/locking-redis": "2.17.2",
    "@medusajs/medusa": "2.17.2",
    "@paypal/paypal-server-sdk": "^2.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "inngest": "^4.2.4",
    "pg": "^8.13.1",
    "stripe": "^15.5.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@medusajs/test-utils": "2.17.2",
    "@medusajs/utils": "2.17.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.56.0",
    "@opentelemetry/exporter-zipkin": "^2.0.0",
    "@swc/core": "1.15.18",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@swc/core-win32-x64-msvc": "1.15.18"
  }
}
