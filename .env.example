# =============================================================================
# 1. Node environment
# =============================================================================
# development | production
# Keep this as development in the local repo .env.local. Production deployments must override NODE_ENV in platform env vars.
NODE_ENV=development

# =============================================================================
# 2. App URLs
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_MESSENGER_URL=
PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_MAINTENANCE_MODE=false
API_URL=http://localhost:4000

# =============================================================================
# 3. NextAuth
# =============================================================================
# Storefront / default callback base (port 3000).
NEXTAUTH_URL=http://localhost:3000
# Staff admin on port 3001: required for Google OAuth redirect to hit the admin app.
ADMIN_NEXTAUTH_URL=http://localhost:3001
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# =============================================================================
# 4. Google OAuth
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# 5. Supabase (platform DB, RBAC, CMS)
# Run: pnpm --filter @universal-music-store/database migrate
# =============================================================================
LEGACY_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_IMAGE_HOSTNAMES=**.supabase.co

# =============================================================================
# 6. Express internal API
# =============================================================================
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=

# =============================================================================
# 7. Express CORS
# =============================================================================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# =============================================================================
# 8. GDPR retention
# =============================================================================
DATA_RETENTION_DAYS=730

# =============================================================================
# 9. Admin
# =============================================================================
ADMIN_ALLOWED_EMAILS=
NEXT_PUBLIC_STAFF_RBAC_STRICT=true
# Generate: openssl rand -hex 32
CHANNEL_WEBHOOK_SECRET=
# Set to true only after a step-up assertion issuer is configured.
ADMIN_STEP_UP_REQUIRED=false
ADMIN_STEP_UP_SECRET=
# Set to true for production terminals after registering pos_device_bindings rows.
TERMINAL_DEVICE_BINDING_REQUIRED=false
# When true, POS online sales require an open shift and shiftId on commit-sale.
POS_SALE_REQUIRES_OPEN_SHIFT=true
# Must match POS_SALE_REQUIRES_OPEN_SHIFT — exposed to browser for POS page.
NEXT_PUBLIC_POS_SALE_REQUIRES_OPEN_SHIFT=true
# Email used for draft orders created via chat / social intake flows.
CHAT_INTAKE_EMAIL=chat-intake@instore.local

# =============================================================================
# 10. Medusa client (storefront and admin)
# Run: pnpm --filter medusa seed:ph  |  pnpm --filter medusa dev
# =============================================================================
NEXT_PUBLIC_MEDUSA_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_REGION_ID=
NEXT_PUBLIC_MEDUSA_SALES_CHANNEL_ID=
NEXT_PUBLIC_MEDUSA_PAYMENT_PROVIDER_ID=pp_stripe_stripe
# Valid values: STRIPE, PAYPAL, XENDIT, COD
NEXT_PUBLIC_CHECKOUT_PAYMENT_PROVIDERS=STRIPE,PAYPAL,XENDIT,COD

MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_API_KEY=
MEDUSA_REGION_ID=
MEDUSA_SALES_CHANNEL_ID=
MEDUSA_SECRET_API_KEY=

# =============================================================================
# 11. Medusa server
# Run: pnpm --filter medusa exec medusa db:migrate
# =============================================================================
# Generate: openssl rand -hex 32
JWT_SECRET=
# Generate: openssl rand -hex 32
COOKIE_SECRET=
DATABASE_URL=
DB_NAME=medusa-v2
# Optional dev bootstrap overrides for `pnpm dev`
MEDUSA_DEV_HEALTH_URL=http://localhost:9000/health
MEDUSA_DEV_WAIT_MS=120000
MEDUSA_DEV_POLL_MS=500

# =============================================================================
# 12. Redis
# =============================================================================
# Medusa 2.x uses a TCP Redis URL for the event bus (not the Upstash REST API).
# Use redis:// or rediss:// from your host (local Redis, Upstash "Redis" connect string, etc.).
# UPSTASH_REDIS_REST_* alone does not satisfy Medusa — you still need REDIS_URL for Medusa.
# Optional alias: MEDUSA_REDIS_URL (same value as REDIS_URL).
REDIS_URL=
MEDUSA_REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# 13. Medusa CORS
# =============================================================================
STORE_CORS=http://localhost:3000
# ADMIN_CORS: :3001 is this repo's custom admin Next.js app. :9000 is Medusa's own built-in admin
# dashboard served at /app on the Medusa process. Include :9000 only if you use the built-in dashboard.
ADMIN_CORS=http://localhost:3001,http://localhost:9000
# AUTH_CORS: allows both the custom admin (:3001) and storefront (:3000) to use Medusa auth endpoints.
# :9000 is included for Medusa's built-in admin dashboard; remove it if you are not using it.
AUTH_CORS=http://localhost:3001,http://localhost:9000
STOREFRONT_PUBLIC_URL=http://localhost:3000

# =============================================================================
# 14. Storefront cron + payment ledger
# =============================================================================
# Vercel sends Authorization Bearer using this value for cron routes.
# Generate: openssl rand -hex 32
CRON_SECRET=
STOREFRONT_PAYMENT_CRON_SECRET=
# When true, POST /api/checkout/complete-medusa-cart requires a correlationId (strict ledger).
STOREFRONT_STRICT_PAYMENT_LEDGER=true
# Shared secret for POST /api/internal/reconcile-payment-attempt.
# Generate: openssl rand -hex 32
STOREFRONT_INTERNAL_RECONCILE_SECRET=
# Base URL of the storefront (used by admin for payment retry finalization).
STOREFRONT_ORIGIN=http://localhost:3000

# =============================================================================
# 15. Medusa payment providers
# Restart Medusa after changing any of these. See docs/runbooks/GUIDE.md.
# =============================================================================

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_FALLBACK_CURRENCY=php
# Use http:// for local dev. Production: replace with your public HTTPS storefront origin.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/stripe-return?stripe_session={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/checkout?stripe_cancel=1

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# sandbox | live
PAYPAL_ENVIRONMENT=sandbox
# Local-only: allow PayPal webhooks without PAYPAL_WEBHOOK_ID. Never enable in production.
MEDUSA_ALLOW_UNVERIFIED_PAYPAL_WEBHOOKS=true
# PayPal sandbox buyer account for e2e tests only.
# Create at https://developer.paypal.com/dashboard/accounts
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=

# Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/hosted-return?provider=xendit&status=success
XENDIT_CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/hosted-return?provider=xendit&status=cancel

# =============================================================================
# 16. Pancake POS logistics bridge (J&T native carrier integration)
# API docs: https://docs.pancake.biz/pos/api/#tag/eng
# =============================================================================
# Keep the demo URL/environment for local QA. Set both explicitly for live.
JNT_API_URL=https://demoopenapi.jtexpress.ph/webopenplatformapi
JNT_ENVIRONMENT=production:no
PANCAKE_POS_API_URL=https://pos.pages.fm/api/v1
PANCAKE_POS_API_KEY=
PANCAKE_POS_SHOP_ID=
PANCAKE_POS_PICKUP_NAME="Universal Music Store"
PANCAKE_POS_PICKUP_PHONE=
PANCAKE_POS_PICKUP_PROVINCE="Cavite"
PANCAKE_POS_PICKUP_CITY="General Trias"
PANCAKE_POS_PICKUP_AREA="Navarro"
PANCAKE_POS_PICKUP_ADDRESS="Cornerspoint 3rd Floor Building,159 F Manalo Road,Beside Of Phoenix Gasoline Station"

# =============================================================================
# 17. Resend transactional email + signed tracking links
# https://resend.com/api-keys
# Medusa requires TRACKING_HMAC_SECRET when RESEND_API_KEY is set in production.
# Generate: openssl rand -hex 32
# =============================================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@universal-music-store.store
RESEND_BRAND_NAME="Universal Music Store"
STORE_NAME="Universal Music Store"
TRACKING_HMAC_SECRET=

# =============================================================================
# 18. SMS notifications via Semaphore.ph
# https://semaphore.co
# =============================================================================
SEMAPHORE_API_KEY=
# Sender name shown on SMS — 11 characters max
SEMAPHORE_SENDER_NAME="MAHARLIKA"

# =============================================================================
# 19. Terminal agent (local POS hardware bridge)
# Default: http://127.0.0.1:17711
# =============================================================================
# Comma-separated origins allowed to call the terminal agent (production: add https://your-admin-host).
TERMINAL_AGENT_CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001

# =============================================================================
# 20. Supabase key age guard
# =============================================================================
# ISO 8601 date of the last SUPABASE_SERVICE_ROLE_KEY rotation.
# Used by scripts/check-key-age.mjs. Leave blank to skip enforcement.
SUPABASE_SERVICE_ROLE_KEY_ROTATED_AT=
# Override default 90-day rotation threshold (days).
# KEY_ROTATION_THRESHOLD_DAYS=90

# =============================================================================
# 21. Admin alerts — low-stock threshold
# =============================================================================
# Units below which a low-stock alert fires. Default 1000 (Scope §2.11 / §9.2).
# Override per item in Medusa inventory-item metadata: min_reorder_level.
ADMIN_LOW_STOCK_THRESHOLD=1000

# =============================================================================
# 22. Sentry error monitoring
# https://sentry.io
# =============================================================================
# Public DSN — safe to expose in browser bundles (sentry.client.config.ts).
NEXT_PUBLIC_SENTRY_DSN=
# Server-only DSN (sentry.server.config.ts, sentry.edge.config.ts).
SENTRY_DSN=
# Org and project slugs for source map uploads during build.
SENTRY_ORG=
SENTRY_PROJECT=storefront
# Auth token required for source map uploads (set as SENTRY_AUTH_TOKEN in CI).
SENTRY_AUTH_TOKEN=

# =============================================================================
# 23. PostHog product analytics + session replay
# https://posthog.com
# =============================================================================
# Browser SDK project token; safe to expose via NEXT_PUBLIC_.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Legacy alias accepted by the SDK helper.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# Server-side capture key. Can reuse the project key if you prefer a single value.
POSTHOG_API_KEY=
# Server-side project token alias. Use this if you want one shared token name across layers.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# 24. Inngest background jobs
# https://www.inngest.com
# =============================================================================
# Leave blank for local dev with the Inngest Dev Server: npx inngest-cli@latest dev
INNGEST_EVENT_KEY=
# Signing key for verifying Inngest webhook payloads in production.
INNGEST_SIGNING_KEY=

# =============================================================================
# 24. Feature flags (kill switches — set to false or 0 to disable a provider)
# =============================================================================
# FEATURE_FLAG_STRIPE=true
# FEATURE_FLAG_PAYPAL=true
# FEATURE_FLAG_XENDIT=true
# FEATURE_FLAG_PANCAKE_POS=true
# FEATURE_FLAG_LOYALTY=true
# FEATURE_FLAG_REVIEWS=true
# FEATURE_FLAG_BOPIS=true
# FEATURE_FLAG_EXPERIMENTS=true

# Nango embedded OAuth for merchant payment accounts.
# Set NANGO_API_KEY to a server-only Nango environment API key with
# environment:connect_sessions:write and environment:proxy. Add
# environment:connections:read_credentials only when direct credential fallback
# is required. Never expose this value through NEXT_PUBLIC_*.
NANGO_API_KEY=
# Comma-separated Nango integration unique keys, for example paypal-sandbox,paypal.
NANGO_PAYMENT_INTEGRATIONS=paypal-sandbox, paypal, stripe
# Optional: signed Nango webhook secret used by /api/webhooks/nango.
NANGO_WEBHOOK_SIGNING_KEY=
# Optional Nango-routed checkout connection. Prefer per-merchant values in cart/payment context.
NANGO_PAYMENT_CONNECTION_ID=
NANGO_PAYMENT_PROVIDER_CONFIG_KEY=
# Required reCAPTCHA Enterprise score-based protection for public mutations.
NEXT_PUBLIC_RECAPTCHA_PROVIDER=enterprise
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_AUTH_DISABLE=false
RECAPTCHA_PROJECT_ID=
RECAPTCHA_ENTERPRISE_API_KEY=
# For standard reCAPTCHA v3 keys, set NEXT_PUBLIC_RECAPTCHA_PROVIDER=standard and provide this server-only secret.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.3
