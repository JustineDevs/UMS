{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["AUTH_DISABLE", "AUTH_DISABLED", "MEDUSA_DB_URL", "APP_DB_URL"],
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".next-production/**",
        "!.next-production/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
